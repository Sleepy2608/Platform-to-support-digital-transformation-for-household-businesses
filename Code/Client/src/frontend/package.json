{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --no-warnings --test --experimental-strip-types tests/*.test.ts",
    "test:low-stock": "node --no-warnings --test --experimental-strip-types tests/lowStockViewModel.test.ts",
    "test:current-stock": "node --no-warnings --test --experimental-strip-types tests/currentStockViewModel.test.ts",
    "test:adjustment": "node --no-warnings --test --experimental-strip-types tests/inventoryAdjustmentViewModel.test.ts",
    "test:debt": "node --no-warnings --test --experimental-strip-types tests/debtBookkeepingViewModel.test.ts",
    "test:bookkeeping": "node --no-warnings --test --experimental-strip-types tests/inventoryBookkeepingViewModel.test.ts",
    "test:roles": "node --no-warnings --test --experimental-strip-types tests/roles.test.ts",
    "test:invoice-format": "node --no-warnings --test --experimental-strip-types tests/invoiceFormat.test.ts",
    "test:inventory": "npm run test:low-stock && npm run test:current-stock && npm run test:adjustment"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
