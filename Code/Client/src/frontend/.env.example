# ==============================================================================
# HBDT Platform — Frontend Environment Configuration Template
# ==============================================================================
# Sao chép tệp này thành `.env.local` để chạy môi trường phát triển (Development):
#   cp .env.example .env.local
#
# Copy this file to `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend REST API Gateway (Spring Boot 3.3.4 / Java 21)
# ------------------------------------------------------------------------------
# Địa chỉ URL của máy chủ Backend API.
# Mặc định local chạy cổng 8080.
# Production trỏ đến domain backend (ví dụ: https://api.hbdt.digital).
NEXT_PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. AI Intelligence Microservice (FastAPI / Python 3.12)
# ------------------------------------------------------------------------------
# Địa chỉ URL của dịch vụ Trợ lý AI bóc tách đơn hàng tiếng Việt tự nhiên.
# Mặc định local chạy cổng 8000.
# Production trỏ đến domain AI microservice (ví dụ: https://ai.hbdt.digital).
NEXT_PUBLIC_AI_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Application Metadata & Environment Mode
# ------------------------------------------------------------------------------
# Chế độ môi trường ứng dụng: development | test | production
NEXT_PUBLIC_APP_ENV=development

# Tên thương hiệu hiển thị
NEXT_PUBLIC_APP_NAME="HBDT.DIGITAL - Nền Tảng Chuyển Đổi Số Hộ Kinh Doanh"
