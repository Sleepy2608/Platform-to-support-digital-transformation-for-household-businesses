# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=household_business_platform
DB_USERNAME=root
DB_PASSWORD=123456

# JWT Configuration
JWT_SECRET=your-base64-encoded-secret-key-at-least-256-bits-long-change-in-production
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Server
SERVER_PORT=8080

# Active Profile
SPRING_PROFILES_ACTIVE=dev

# Safety: shared databases must never be modified or seeded automatically.
APP_SEED_ROLES_ENABLED=true
APP_SEED_DEMO_USERS_ENABLED=false
APP_REFERENCE_DATA_ENABLED=true
