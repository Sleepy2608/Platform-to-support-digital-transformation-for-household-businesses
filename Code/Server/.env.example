# database config for local host
DB_HOST=localhost
DB_PORT=3306
DB_NAME=<ten_database_local_cua_ban>
DB_USERNAME=<ten_user_local_cua_ban>
DB_PASSWORD=<mat_khau_local_cua_ban>

# Tao san tai khoan admin/owner khi khoi dong
APP_SEED_DEMO_USERS_ENABLED=true

# BAI key belongs only in Code/AI/.env. This secret authenticates backend -> AI.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_SECRET=
AI_SERVICE_TIMEOUT_SECONDS=35
