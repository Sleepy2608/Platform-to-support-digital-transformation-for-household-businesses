# B.ai API key from https://chat.b.ai/key (server-side only).
BAI_API_KEY=
# Exact ID returned by GET https://api.b.ai/v1/models; e.g. qwen3.8-flash if available.
BAI_MODEL=qwen3.8-flash
BAI_BASE_URL=https://api.b.ai/v1
BAI_TIMEOUT_SECONDS=25
# Generate a secret and set the same value in Code/Server/.env.
AI_SERVICE_API_SECRET=
